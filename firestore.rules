rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3 & Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidTimeHHMM(val) {
      return val is string && val.size() == 5 && val.matches('^([01]\\d|2[0-3]):[0-5]\\d$');
    }

    function isValidDateKey(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidBookmarksList(list) {
      return list is list
        && list.size() <= 100
        && (list.size() == 0 || (list[0] is string && list[0].size() >= 1 && list[0].size() <= 64));
    }

    // Pillar 2: Validation Blueprints (verbatim bounds from firebase-blueprint.json)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'displayName',
          'themeMode',
          'nightReadingWarmth',
          'passcodeEnabled',
          'passcodeHash',
          'passcodeSalt',
          'reminderEnabled',
          'morningReminderTime',
          'eveningReminderTime',
          'bookmarkedVerseIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'displayName',
          'themeMode',
          'nightReadingWarmth',
          'passcodeEnabled',
          'passcodeHash',
          'passcodeSalt',
          'reminderEnabled',
          'morningReminderTime',
          'eveningReminderTime',
          'bookmarkedVerseIds',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.themeMode in ['light', 'dark']
        && data.nightReadingWarmth is bool
        && data.passcodeEnabled is bool
        && data.passcodeHash is string && data.passcodeHash.size() <= 128
        && data.passcodeSalt is string && data.passcodeSalt.size() <= 64
        && data.reminderEnabled is bool
        && isValidTimeHHMM(data.morningReminderTime)
        && isValidTimeHHMM(data.eveningReminderTime)
        && isValidBookmarksList(data.bookmarkedVerseIds)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrayerEntry(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'body',
          'category',
          'verseRef',
          'answered',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'body',
          'category',
          'verseRef',
          'answered',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 4000
        && data.category in ['Strength', 'Confession', 'Gratitude', 'Renewal']
        && data.verseRef is string && data.verseRef.size() <= 80
        && data.answered is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCheckin(data, userId, checkinId) {
      return data.keys().hasAll([
          'ownerId',
          'dateKey',
          'status',
          'reflection',
          'hasLocalPhoto',
          'photoCaption',
          'urgesResisted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'dateKey',
          'status',
          'reflection',
          'hasLocalPhoto',
          'photoCaption',
          'urgesResisted',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidDateKey(data.dateKey)
        && data.dateKey == checkinId
        && data.status in ['steadfast', 'overcame', 'grace']
        && data.reflection is string && data.reflection.size() <= 1000
        && data.hasLocalPhoto is bool
        && data.photoCaption is string && data.photoCaption.size() <= 200
        && data.urgesResisted is int && data.urgesResisted >= 0 && data.urgesResisted <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow list: if false;
      allow get: if isVerifiedOwner(userId) && isValidId(userId);
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update reading & appearance preferences
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'themeMode', 'nightReadingWarmth', 'updatedAt']) ||
          // Action: Update passcode lock settings
          incoming().diff(existing()).affectedKeys().hasOnly(['passcodeEnabled', 'passcodeHash', 'passcodeSalt', 'updatedAt']) ||
          // Action: Update gentle reminder schedule
          incoming().diff(existing()).affectedKeys().hasOnly(['reminderEnabled', 'morningReminderTime', 'eveningReminderTime', 'updatedAt']) ||
          // Action: Update bookmarked verses
          incoming().diff(existing()).affectedKeys().hasOnly(['bookmarkedVerseIds', 'updatedAt'])
        );
      allow delete: if isVerifiedOwner(userId)
        && isValidId(userId)
        && existing().ownerId == request.auth.uid;

      // Collection 2: /users/{userId}/prayers/{prayerId}
      match /prayers/{prayerId} {
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow get: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(prayerId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(prayerId)
          && isValidPrayerEntry(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(prayerId)
          && isValidPrayerEntry(incoming(), userId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            // Action: Edit prayer content
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'category', 'verseRef', 'updatedAt']) ||
            // Action: Toggle answered state
            incoming().diff(existing()).affectedKeys().hasOnly(['answered', 'updatedAt'])
          );
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(prayerId)
          && existing().ownerId == request.auth.uid;
      }

      // Collection 3: /users/{userId}/checkins/{checkinId}
      match /checkins/{checkinId} {
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow get: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(checkinId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(checkinId)
          && isValidCheckin(incoming(), userId, checkinId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(checkinId)
          && isValidCheckin(incoming(), userId, checkinId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().dateKey == existing().dateKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            // Action: Update daily check-in reflection or photo metadata
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reflection', 'hasLocalPhoto', 'photoCaption', 'urgesResisted', 'updatedAt'])
          );
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(checkinId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
